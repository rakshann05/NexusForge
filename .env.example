# Application
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
PORT=4000

# Database
DATABASE_URL=postgresql://nexusforge:nexusforge_dev_password@localhost:5432/nexusforge?schema=public

# Auth - replace these values outside local development
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Optional AI. Leave unset to keep AI features disabled.
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=

# Optional Redis (reserved for cache, queues, and multi-instance realtime scaling)
REDIS_URL=
