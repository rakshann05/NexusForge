# Copy this file to `.env` at the repository root and fill in real values.
# The API (apps/api) and the Prisma CLI both read this root .env file.
# `.env` is gitignored; never commit real secrets.

# ── Application ──────────────────────────────────────────────────────────────
# NODE_ENV: development | test | production. In production the app refuses
# placeholder JWT secrets and refuses to reuse one secret for both tokens.
NODE_ENV=development
# API_PORT: port the NestJS API listens on (1-65535).
API_PORT=4000
# CORS_ORIGIN: exact origin allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_API_URL: base URL the Next.js frontend uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL: PostgreSQL connection string (postgres:// or postgresql://).
DATABASE_URL=postgresql://nexusforge:nexusforge_dev_password@localhost:5432/nexusforge?schema=public

# ── Auth ─────────────────────────────────────────────────────────────────────
# JWT secrets must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use different values for access and refresh, and replace both outside local dev.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-characters
# Token lifetimes (any value the jsonwebtoken library accepts, e.g. 15m, 7d).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Redis (optional) ─────────────────────────────────────────────────────────
# Reserved for cache, queues, and multi-instance realtime scaling. The API
# boots without it.
REDIS_URL=redis://localhost:6379

# ── Optional development seed user ───────────────────────────────────────────
# If both are set (and NODE_ENV is not production), `npm run db:seed` creates a
# local login. The password is read from here and never hardcoded. Leave unset
# to skip. Never enable in production.
# DEV_SEED_USER_EMAIL=dev@nexusforge.local
# DEV_SEED_USER_PASSWORD=
